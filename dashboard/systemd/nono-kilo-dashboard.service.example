[Unit]
Description=OpenSensor Kilo sandbox dashboard
After=network.target

[Service]
Type=simple
# Replace these paths with your checkout and installed runtimes.
WorkingDirectory=/absolute/path/to/nono-kilo/dashboard
ExecStart=/absolute/path/to/node /absolute/path/to/nono-kilo/dashboard/server.mjs
Environment="PATH=/absolute/path/to/runtime/bin:/usr/local/bin:/usr/bin:/bin"
Environment=OPENSENSOR_NONO=/absolute/path/to/nono
Environment=OPENSENSOR_KILO=/absolute/path/to/kilo
Environment=OPENSENSOR_PORT=4317
# For a trusted LAN, also set OPENSENSOR_HOST=0.0.0.0.
UMask=0077
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=12

[Install]
WantedBy=default.target
